AddType application/vnd.android.package-archive .apk
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=kalima.apk"
  </FilesMatch>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Ni clés, ni configs, ni sources des contenus, ni outils
<FilesMatch "\.(jks|keystore|properties|py|md|txt|tsv)$">
  Require all denied
</FilesMatch>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/css application/javascript text/html image/svg+xml
</IfModule>
