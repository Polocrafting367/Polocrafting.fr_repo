AddType application/vnd.android.package-archive .apk
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment; filename=curio.apk"
  </FilesMatch>
  <FilesMatch "^(sw\.js|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Ne jamais servir de clés ou configs par erreur
<FilesMatch "\.(jks|keystore|properties|py|md)$">
  Require all denied
</FilesMatch>

# Dictionnaires : compressés et mis en cache
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/css application/javascript text/html
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 7 days"
</IfModule>
